PGHOST=localhost
PGPORT=5432
PGUSER=tecnedub_ots_app
PGPASSWORD=
PGDATABASE=tecnedub_ots_main
JWT_SECRET=
# Max session lifetime if never renewed. The frontend calls POST /auth/v1/refresh
# every ~30s while a tab is open/focused (throttled client-side to once per 6h),
# so an active user's session keeps sliding forward -- only someone who stops
# visiting entirely gets auto-logged-out, after this many days of inactivity.
JWT_EXPIRE=2d
PORT=3000

# Google "Continue with Google" login (backend/src/functions/googleOAuth.js).
# From Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Add GOOGLE_REDIRECT_URI as an Authorized redirect URI there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.onlinetextileschool.com/auth/v1/google/callback
FRONTEND_URL=https://onlinetextileschool.com
