name: Deploy Website
on:
  push:
    branches:
      - main # Tomar branch name jodi onno kichu hoy (e.g. master), seta ekhane likhbe

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Bun
        uses: oven-sh/setup-bun@v1
        with:
          bun-version: latest

      - name: Install Dependencies
        run: bun install

      - name: Build Project
        run: bun run build

      - name: FTP Deploy
        uses: SamKirkland/FTP-Deploy-Action@v4.3.4
        with:
          server: ${{ secrets.FTP_SERVER }}
          username: ${{ secrets.FTP_USERNAME }}
          password: ${{ secrets.FTP_PASSWORD }}
          # Lovable/Vite er build folder holo distk
          local-dir: ./dist/ 
          # Tomar specific domain folder path
          server-dir: ./onlinetextileschool.com/
          # dangerous-clean-slate wipes the ENTIRE remote folder first, then
          # re-uploads everything over FTP (which is slow, file-by-file, not
          # atomic) -- for that whole window the docroot has no index.html,
          # so LiteSpeed falls back to a public directory listing and the
          # live site is effectively down. Incremental sync (this action's
          # default without the flag) only touches changed/new files, so the
          # previous working build keeps serving until each file is replaced
          # -- no empty-docroot window. Orphaned old JS chunks accumulate
          # over time but are harmless (unreferenced, never served).
          dangerous-clean-slate: false
